#!/bin/sh
# Refuse to push a branch whose pull request is already merged: the commits
# would never reach main. Branch off origin/main and open a new PR instead.
command -v gh >/dev/null 2>&1 || exit 0

while read -r local_ref _ remote_ref _; do
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  branch=${remote_ref#refs/heads/}
  [ "$branch" = main ] && continue
  [ "$local_ref" = "(delete)" ] && continue
  state=$(gh pr view "$branch" --json state -q .state 2>/dev/null) || continue
  if [ "$state" = MERGED ]; then
    echo "pre-push: the PR for '$branch' is already merged; these commits would never reach main." >&2
    echo "Branch off origin/main and open a new PR instead." >&2
    exit 1
  fi
done
exit 0
